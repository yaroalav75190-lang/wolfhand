# ── Обязательное ─────────────────────────────────────────────────────────────
PUBLIC_ORIGIN=https://wolf.example.ru        # адрес акции; попадает в QR-ссылки
WOLF_SESSION_SECRET=                          # openssl rand -hex 32 — подпись cookie персонала
NODE_ENV=production
KV_DRIVER=sqlite                              # sqlite (прод) | memory (локальная разработка)
SQLITE_PATH=/var/lib/wolfhand/wolfhand.sqlite

# ── Пароли служебного контура ────────────────────────────────────────────────
MANAGER_PASSWORD=                             # управляющий: сводка клуба
MARKETING_PASSWORD=                           # маркетолог: витрина, лиды, выдачи
# Партнёрам — по паролю на каждого (кабинет со своей статистикой и погашением сертификатов)
PARTNER_PASSWORD_HELLOAPPLE=
PARTNER_PASSWORD_LEVVEL=
PARTNER_PASSWORD_CHAPAEV=
PARTNER_PASSWORD_KONTORA=
# Роль staff (стойка клуба) входит по имени и фамилии, без пароля — см. api/admin/login.js

# ── Защита призового фонда ───────────────────────────────────────────────────
PRIZE_BUDGET_DAILY_COGS=5000                  # дневной потолок прямых затрат клуба, ₽ (0 — выключить)
JACKPOT_MIN_INTERVAL_DAYS=30                  # окно тишины после джекпота (0 — выключить)

# ── Прочее ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=true                            # false только для теста по HTTP без сертификата
DEV_MODE=0                                    # 1 включает forceCombo в /api/deal — НИКОГДА не на проде
PORT=3000
HOST=127.0.0.1
